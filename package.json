{
  "name": "@patrykparcheta/react-search-and-filter",
  "version": "0.1.0",
  "description": "Customizable React search, filters, sorting and pagination powered by Quickstate.",
  "type": "module",
  "license": "MIT",
  "author": "Patryk Parcheta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpatrykk/react-search-and-filter.git"
  },
  "homepage": "https://react-search-and-filter.vercel.app",
  "keywords": [
    "react",
    "search",
    "filters",
    "pagination",
    "quickstate",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "docs:dev": "vite docs --host 127.0.0.1",
    "docs:build": "npm run build && vite build docs",
    "audit:full": "npm audit --include=dev --audit-level=low",
    "prepack": "npm run build",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@quickstate/core": "^2.0.1"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@quickstate/core": "^2.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.1",
    "vite": "^7.3.0",
    "vitest": "^4.1.12",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@playwright/test": "^1.58.0",
    "postcss": "^8.5.0"
  }
}
